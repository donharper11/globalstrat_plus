#!/usr/bin/env bash
# ─── refresh the .5 clone of aide-checks from this one ──────────────────────
# OPTIONAL FALLBACK. .5 pulls from GitHub directly over SSH and has since
# 2026-09-03; `git pull` there is the normal path.
#
# This script exists because .5's aide-checks clone was originally created with
# an HTTPS origin and no credential helper, so `git pull` failed with "could not
# read Username". That was one repo's remote URL, not a missing credential on
# the host — .5's other repos already used SSH and authenticated fine. The clone
# now uses git@github.com and the relay is not needed for routine syncs.
#
# Kept for the case it actually covers: moving a revision to .5 when GitHub is
# unreachable from there, by bundle -> scp -> fetch.
set -euo pipefail
PKG="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOST="${1:-ubuntu@192.168.50.5}"
B=/tmp/aide-checks.bundle
git -C "$PKG" bundle create "$B" --all >/dev/null 2>&1
scp -q "$B" "$HOST:/tmp/aide-checks.bundle"
ssh -o BatchMode=yes "$HOST" '
  set -e; cd ~/projects/aide-checks
  git fetch -q /tmp/aide-checks.bundle "+refs/heads/*:refs/remotes/relay/*"
  git checkout -q main 2>/dev/null || git checkout -qb main
  git reset -q --hard relay/main
  git rev-parse --short HEAD'
echo "push-to-vm5: .5 now at the above revision"
