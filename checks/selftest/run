#!/usr/bin/env bash
# ─── aide-checks selftest runner ────────────────────────────────────────────
# AP-R10, in force in aide-platform since 2026-08-18, form `check`:
#   "a check counts only when the packet proves it can fail."
#
# Adopted as this package's standard (spec §6). Every check gets a selftest that
#   1. builds a disposable git repo,
#   2. asserts the check PASSES on it (no false positive),
#   3. plants a violation,
#   4. asserts the check FAILS non-zero on the plant,
#   5. removes the plant and asserts it passes again.
#
# A check whose selftest does not do all five is not enabled in any repo config.
set -uo pipefail
PKG="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PASS=0; FAIL=0
say() { printf '%s\n' "$*"; }
assert_rc() { # assert_rc <expected> <actual> <label>
  if [ "$2" -eq "$1" ]; then say "    ok    $3 (exit $2)"; PASS=$((PASS+1));
  else say "    FAIL  $3 (expected exit $1, got $2)"; FAIL=$((FAIL+1)); fi
}

# The revision assertion (spec §2) applies to every run-checks invocation, so a
# synthetic repo has to carry a vendored stamp the same way a real one does.
# Asking the runner what it is, rather than recomputing it here, is deliberate:
# a selftest that re-derives the value it is checking proves nothing.
PKG_REV="$("$PKG/bin/run-checks" --print-revision 2>/dev/null || echo unknown)"
stamp_repo() { mkdir -p "$1/checks"; printf '%s\n' "${2:-$PKG_REV}" > "$1/checks/.aide-checks-rev"; }

mk_repo() {
  local d; d="$(mktemp -d)"
  git init -q "$d"; git -C "$d" config user.email t@t; git -C "$d" config user.name t
  mkdir -p "$d/docs" "$d/src"
  printf '# readme\n' > "$d/README.md"
  printf 'hello\n'     > "$d/docs/guide.md"
  printf 'print(1)\n'  > "$d/src/app.py"
  git -C "$d" add -A >/dev/null; git -C "$d" commit -qm init
  echo "$d"
}

# ══════════════════════════════════════════════════════════════════════════
say "selftest: no-committed-secrets"
D="$(mk_repo)"
cat > "$D/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": { "no-committed-secrets": { "enabled": true, "mode": "blocking",
    "include": ["docs/**", "README.md"], "exclude": ["**/site-packages/**"] } } }
JSON
git -C "$D" add -A >/dev/null; git -C "$D" commit -qm cfg

"$PKG/sh/no-committed-secrets" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "clean tree passes"

# 3. plant. NOT the canonical AWS example key: gitleaks ships that in its default
# allowlist, so planting it proves the opposite of what the selftest claims. A
# private-key block fires the version-stable `private-key` rule and carries no
# credential value. Assembled from parts so this file does not itself contain a
# secret-shaped literal — aide-checks is scanned by aide-checks.
PLANT="$D/docs/setup.md"
{ printf -- '-----BEGIN RSA %s-----\n' 'PRIVATE KEY'
  printf 'MIIEowIBAAKCAQEA%s\n' 'FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE'
  printf -- '-----END RSA %s-----\n' 'PRIVATE KEY'; } > "$PLANT"
git -C "$D" add -A >/dev/null; git -C "$D" commit -qm plant >/dev/null
OUT="$("$PKG/sh/no-committed-secrets" "$D" "$D/checks.config.json" 2>&1)"; RC=$?
assert_rc 1 $RC "planted secret in docs/ fails the check"
printf '%s' "$OUT" | grep -q 'docs/setup.md' \
  && { say "    ok    finding names the planted path"; PASS=$((PASS+1)); } \
  || { say "    FAIL  finding does not name the planted path"; FAIL=$((FAIL+1)); }
printf '%s' "$OUT" | grep -q 'MIIEowIBAAKCAQEA' \
  && { say "    FAIL  output leaked the secret value"; FAIL=$((FAIL+1)); } \
  || { say "    ok    output never prints the value"; PASS=$((PASS+1)); }

# untracked plant must NOT fail — this is the false positive that gets a layer disabled
git -C "$D" rm -q --cached docs/setup.md >/dev/null; printf 'docs/setup.md\n' >> "$D/.gitignore"
git -C "$D" add .gitignore >/dev/null; git -C "$D" commit -qm untrack >/dev/null
"$PKG/sh/no-committed-secrets" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "same secret, untracked and gitignored, does not fail"

# A scanner that is absent must be exit 2, not exit 0. An unrunnable check that
# reports success is the failure mode AP-R10 exists to prevent.
#
# Asserted through AIDE_CHECKS_GITLEAKS rather than by hiding the binary. Hiding
# it was environment-dependent and quietly wrong: on both VMs gitleaks lives in
# ~/bin, so faking HOME concealed it and this passed, but a CI runner installs it
# to /usr/local/bin, which find_gitleaks probes by absolute path whatever PATH
# and HOME say. The check found it, exited 0, and this assertion failed on every
# CI run since phase 1 — the AP-R10 proof step red, in the one place nobody was
# reading it, because CI is advisory.
( AIDE_CHECKS_GITLEAKS="/nonexistent/gitleaks" \
  "$PKG/sh/no-committed-secrets" "$D" "$D/checks.config.json" >/dev/null 2>&1 )
assert_rc 2 $? "a scanner path that does not exist is exit 2, not a silent pass"

# and a binary that is not a scanner cannot manufacture a pass either: it writes
# no report, which is could-not-run, not zero findings.
( AIDE_CHECKS_GITLEAKS="/bin/true" \
  "$PKG/sh/no-committed-secrets" "$D" "$D/checks.config.json" >/dev/null 2>&1 )
assert_rc 2 $? "a scanner that produces no report is exit 2, not zero findings"

# 5. remove the plant
rm -f "$PLANT"; git -C "$D" add -A >/dev/null; git -C "$D" commit -qm cleanup >/dev/null
"$PKG/sh/no-committed-secrets" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "plant removed, check passes again"

# ══════════════════════════════════════════════════════════════════════════
# allow_fields — suppress an identifier-shaped field WITHOUT excluding its path.
# The danger this guards against is a scanner that looks green because someone
# allowlisted the directory a real leak would land in. Every assertion below
# exists to prove the file is still being scanned.
say "selftest: no-committed-secrets / allow_fields"
D2="$(mk_repo)"
mkdir -p "$D2/evidence"

# An identifier with real entropy, assembled from parts so this selftest file
# does not itself carry a secret-shaped literal.
IDENT="$(printf '%s%s%s' 'b7f3a91c4d2e' '48a6b0c5f19d' '3e7a2c8b6f04')"
printf '{"idempotency_key": "%s", "label": "checkout"}\n' "$IDENT" > "$D2/evidence/run.json"
git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm evidence >/dev/null

cfg() { cat > "$D2/checks.config.json"; git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm cfg >/dev/null 2>&1; }

# baseline: with no allowlist the identifier IS reported, so we know the plant fires
cfg <<'JSON'
{ "stack": "python",
  "checks": { "no-committed-secrets": { "enabled": true, "mode": "blocking",
    "include": ["docs/**", "README.md"] } } }
JSON
"$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" >/dev/null 2>&1
assert_rc 1 $? "baseline: identifier field is reported when not allowlisted"

# 1. allowlisted field is suppressed
cfg <<'JSON'
{ "stack": "python",
  "checks": { "no-committed-secrets": { "enabled": true, "mode": "blocking",
    "include": ["docs/**", "README.md"],
    "allow_fields": ["idempotency_key"],
    "allow_fields_reasons": { "idempotency_key": "request de-duplication id in captured browser-proof evidence; not a credential" } } } }
JSON
OUT="$("$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" 2>&1)"; RC=$?
assert_rc 0 $RC "allowlisted field is suppressed"
printf '%s' "$OUT" | grep -q 'suppressed by allow_fields' \
  && { say "    ok    suppression is reported, not silent"; PASS=$((PASS+1)); } \
  || { say "    FAIL  suppression was silent"; FAIL=$((FAIL+1)); }

# 2. THE ONE THAT MATTERS: a real secret in the SAME file still fails.
# If this passes, allow_fields has become a path exclusion and is unsafe.
{ printf -- '-----BEGIN RSA %s-----\n' 'PRIVATE KEY'
  printf 'MIIEowIBAAKCAQEA%s\n' 'FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE'
  printf -- '-----END RSA %s-----\n' 'PRIVATE KEY'; } >> "$D2/evidence/run.json"
git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm realplant >/dev/null
OUT="$("$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" 2>&1)"; RC=$?
assert_rc 1 $RC "real secret in an allowlisted file STILL fails (path not excluded)"
printf '%s' "$OUT" | grep -q 'evidence/run.json' \
  && { say "    ok    finding names the still-scanned file"; PASS=$((PASS+1)); } \
  || { say "    FAIL  finding does not name the file"; FAIL=$((FAIL+1)); }

# restore
printf '{"idempotency_key": "%s", "label": "checkout"}\n' "$IDENT" > "$D2/evidence/run.json"
git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm restore >/dev/null

# 3. the same value under a NON-allowlisted field still fails
printf '{"api_key": "%s"}\n' "$IDENT" > "$D2/evidence/other.json"
git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm otherfield >/dev/null
"$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" >/dev/null 2>&1
assert_rc 1 $? "same value under a non-allowlisted field still fails"
rm -f "$D2/evidence/other.json"; git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm rmother >/dev/null

# 3b. a qualified reference to the same field (SQL alias / property access) is
# treated as that field, but a DIFFERENT field that merely ends in the same
# characters is not — the name must match in full.
printf 'SELECT x FROM t WHERE f.idempotency_key=%s%s%s\n' "'" "$IDENT" "'" > "$D2/evidence/q.sql"
printf '{"other_idempotency_key": "%s"}\n' "$IDENT" > "$D2/evidence/near.json"
git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm qualified >/dev/null
cfg <<'JSON'
{ "stack": "python",
  "checks": { "no-committed-secrets": { "enabled": true, "mode": "blocking",
    "include": ["docs/**", "README.md"],
    "allow_fields": ["idempotency_key"],
    "allow_fields_reasons": { "idempotency_key": "request de-duplication id; not a credential" } } } }
JSON
OUT="$("$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" 2>&1)"; RC=$?
assert_rc 1 $RC "a near-miss field name is NOT suppressed by the allowlist"
printf '%s' "$OUT" | grep -q 'near.json' \
  && { say "    ok    the near-miss field is the one still reported"; PASS=$((PASS+1)); } \
  || { say "    FAIL  near-miss field was wrongly suppressed"; FAIL=$((FAIL+1)); }
printf '%s' "$OUT" | grep -q 'q.sql' \
  && { say "    FAIL  qualified f.idempotency_key was not suppressed"; FAIL=$((FAIL+1)); } \
  || { say "    ok    qualified f.idempotency_key is suppressed"; PASS=$((PASS+1)); }
rm -f "$D2/evidence/q.sql" "$D2/evidence/near.json"
git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm rmq >/dev/null

# 3c. allow_findings pins an exception to ONE occurrence. The load-bearing
# property is that it does NOT become a path or file exclusion.
printf -- '-----BEGIN RSA %s-----\n' 'PRIVATE KEY' > "$D2/evidence/pinned.md"
printf 'MIIEowIBAAKCAQEA%s\n' 'FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE' >> "$D2/evidence/pinned.md"
printf -- '-----END RSA %s-----\n' 'PRIVATE KEY' >> "$D2/evidence/pinned.md"
git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm pinned >/dev/null
cfg <<'JSON'
{ "stack": "python",
  "checks": { "no-committed-secrets": { "enabled": true, "mode": "blocking",
    "include": ["docs/**", "README.md"],
    "allow_fields": ["idempotency_key"],
    "allow_fields_reasons": { "idempotency_key": "request de-duplication id; not a credential" },
    "allow_findings": { "evidence/pinned.md:private-key:1": "selftest fixture" } } } }
JSON
"$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "a pinned fingerprint is suppressed"

# a SECOND secret in the same pinned file, at a different line, still fails
printf -- '\n-----BEGIN EC %s-----\nMHcCAQEEIF%s\n-----END EC %s-----\n' 'PRIVATE KEY' 'FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE' 'PRIVATE KEY' >> "$D2/evidence/pinned.md"
git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm second >/dev/null
"$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" >/dev/null 2>&1
assert_rc 1 $? "a different secret in the SAME pinned file still fails"
rm -f "$D2/evidence/pinned.md"; git -C "$D2" add -A >/dev/null; git -C "$D2" commit -qm rmpin >/dev/null

# a pin without a reason is refused
cfg <<'JSON'
{ "stack": "python",
  "checks": { "no-committed-secrets": { "enabled": true, "mode": "blocking",
    "include": ["docs/**", "README.md"],
    "allow_fields": ["idempotency_key"],
    "allow_fields_reasons": { "idempotency_key": "request de-duplication id; not a credential" },
    "allow_findings": { "evidence/run.json:generic-api-key:1": "" } } } }
JSON
"$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" >/dev/null 2>&1
assert_rc 2 $? "allow_findings without a reason is exit 2"

# 4. an allow_fields entry with no recorded reason is refused, not honoured
cfg <<'JSON'
{ "stack": "python",
  "checks": { "no-committed-secrets": { "enabled": true, "mode": "blocking",
    "include": ["docs/**", "README.md"],
    "allow_fields": ["idempotency_key"] } } }
JSON
"$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" >/dev/null 2>&1
assert_rc 2 $? "allow_fields without a reason is exit 2, not a silent allow"

# 5. a non-bare field name is refused rather than injected into the regex
cfg <<'JSON'
{ "stack": "python",
  "checks": { "no-committed-secrets": { "enabled": true, "mode": "blocking",
    "include": ["docs/**", "README.md"],
    "allow_fields": [".*"],
    "allow_fields_reasons": { ".*": "attempt to allowlist everything" } } } }
JSON
"$PKG/sh/no-committed-secrets" "$D2" "$D2/checks.config.json" >/dev/null 2>&1
assert_rc 2 $? "a regex in allow_fields is refused, not honoured"
rm -rf "$D2"
rm -rf "$D"

# ══════════════════════════════════════════════════════════════════════════
say "selftest: no-agent-worktrees-tracked"
D="$(mk_repo)"
cat > "$D/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": { "no-agent-worktrees-tracked": { "enabled": true, "mode": "blocking",
    "patterns": [".claude/worktrees", "worktrees"] } } }
JSON
git -C "$D" add -A >/dev/null; git -C "$D" commit -qm cfg

"$PKG/sh/no-agent-worktrees-tracked" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "clean tree passes"

# an untracked worktree directory must NOT fail — globalstrat+ has one right now
mkdir -p "$D/.claude/worktrees/agent-abc"; printf 'x\n' > "$D/.claude/worktrees/agent-abc/f.txt"
"$PKG/sh/no-agent-worktrees-tracked" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "worktree present but untracked does not fail"

# 3. plant — track it
git -C "$D" add -f .claude/worktrees/agent-abc/f.txt >/dev/null
git -C "$D" commit -qm plant >/dev/null
OUT="$("$PKG/sh/no-agent-worktrees-tracked" "$D" "$D/checks.config.json" 2>&1)"; RC=$?
assert_rc 1 $RC "tracked worktree path fails the check"
printf '%s' "$OUT" | grep -q '.claude/worktrees/agent-abc/f.txt' \
  && { say "    ok    finding names the tracked path"; PASS=$((PASS+1)); } \
  || { say "    FAIL  finding does not name the tracked path"; FAIL=$((FAIL+1)); }

# an empty pattern list cannot fail, so the check must refuse to run
cat > "$D/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": { "no-agent-worktrees-tracked": { "enabled": true, "mode": "blocking", "patterns": [] } } }
JSON
"$PKG/sh/no-agent-worktrees-tracked" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 2 $? "empty pattern list is refused, not silently passed"

# 5. remove the plant
cat > "$D/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": { "no-agent-worktrees-tracked": { "enabled": true, "mode": "blocking",
    "patterns": [".claude/worktrees", "worktrees"] } } }
JSON
git -C "$D" rm -rq --cached .claude >/dev/null; git -C "$D" commit -qm cleanup >/dev/null
"$PKG/sh/no-agent-worktrees-tracked" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "plant removed, check passes again"
rm -rf "$D"

# ══════════════════════════════════════════════════════════════════════════
say "selftest: run-checks modes"
D="$(mk_repo)"
cat > "$D/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": {
    "no-committed-secrets": { "enabled": true, "mode": "blocking", "fast": true,
      "include": ["docs/**", "README.md"], "exclude": [] },
    "no-agent-worktrees-tracked": { "enabled": true, "mode": "blocking", "fast": false,
      "patterns": [".claude/worktrees"] } } }
JSON
stamp_repo "$D"
git -C "$D" add -A >/dev/null; git -C "$D" commit -qm cfg
"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1;        assert_rc 0 $? "--full passes on a clean repo"
O="$("$PKG/bin/run-checks" --fast --repo="$D" 2>&1)";             assert_rc 0 $? "--fast passes on a clean repo"
printf '%s' "$O" | grep -q 'SKIP no-agent-worktrees-tracked (not in the --fast subset)' \
  && { say "    ok    --fast honours the fast subset"; PASS=$((PASS+1)); } \
  || { say "    FAIL  --fast did not skip the non-fast check"; FAIL=$((FAIL+1)); }

mkdir -p "$D/.claude/worktrees/a"; printf 'x\n' > "$D/.claude/worktrees/a/f"
git -C "$D" add -f .claude >/dev/null; git -C "$D" commit -qm plant >/dev/null
"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1;         assert_rc 1 $? "--full fails on a planted violation"
"$PKG/bin/run-checks" --report-only --repo="$D" >/dev/null 2>&1;  assert_rc 0 $? "--report-only exits 0 on the same violation"
"$PKG/bin/run-checks" --fast --repo="$D" >/dev/null 2>&1;         assert_rc 0 $? "--fast skips it, so exits 0"

python3 - "$D/checks.config.json" <<'PY'
import json,sys
c=json.load(open(sys.argv[1])); c["checks"]["no-agent-worktrees-tracked"]["mode"]="report-only"
c["checks"]["no-agent-worktrees-tracked"]["fast"]=True
json.dump(c,open(sys.argv[1],"w"),indent=2)
PY
"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 0 $? "a report-only check does not block --full"

python3 - "$D/checks.config.json" <<'PY'
import json,sys
c=json.load(open(sys.argv[1])); c["checks"]["not-a-real-check"]={"enabled":True,"mode":"blocking"}
json.dump(c,open(sys.argv[1],"w"),indent=2)
PY
"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 2 $? "a configured check with no executable is could-not-run, not a skip"
rm -rf "$D"

# §2.1/§2.3: a CI run must leave a receipt, and the final workflow assertion
# must fail when that receipt is absent. The assertion is deliberately tested
# before the run, then against the receipt produced by the run.
say "selftest: receipt and CI assertion"
D="$(mk_repo)"
cat > "$D/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": { "no-agent-worktrees-tracked": { "enabled": true, "mode": "blocking",
    "patterns": [".claude/worktrees"] } } }
JSON
stamp_repo "$D"
git -C "$D" add -A >/dev/null; git -C "$D" commit -qm cfg
"$PKG/bin/assert-ci-receipt" "$D" >/dev/null 2>&1
assert_rc 1 $? "CI receipt assertion fails before a run"
AIDE_CHECKS_ENV=ci "$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 0 $? "CI-mode run writes a receipt"
"$PKG/bin/assert-ci-receipt" "$D" >/dev/null 2>&1
assert_rc 0 $? "CI receipt assertion passes on a real receipt"
jq -e '.environment == "ci" and .ran == 1 and .exit_code == 0 and (.checks_run[0].units_examined > 0)' \
  "$D/checks/.last-run.json" >/dev/null 2>&1
assert_rc 0 $? "receipt carries CI environment, run count, exit and units"

# The assertion has to reject a receipt that satisfies every type and states
# the opposite of what it certifies. Each case below alters exactly one value
# of the real receipt, so a pass proves that rule bites and not another.
REAL="$D/checks/.last-run.json"
FORGED="$D/forged.json"
forge() { jq "$1" "$REAL" > "$FORGED"; }

forge '.environment = "local"'
"$PKG/bin/assert-ci-receipt" "$D" "$FORGED" >/dev/null 2>&1
assert_rc 1 $? "receipt assertion rejects a non-ci environment"

forge '.committed_revision = "deadbee"'
"$PKG/bin/assert-ci-receipt" "$D" "$FORGED" >/dev/null 2>&1
assert_rc 1 $? "receipt assertion rejects vendored != committed revision"

# Both revisions changed together: internally consistent, still not this
# checkout. Without the repo anchor this case passes.
forge '.vendored_revision = "deadbee" | .committed_revision = "deadbee"'
"$PKG/bin/assert-ci-receipt" "$D" "$FORGED" >/dev/null 2>&1
assert_rc 1 $? "receipt assertion rejects revisions that agree but are not the repo's"

forge '.ran = 0 | .checks_run = []'
"$PKG/bin/assert-ci-receipt" "$D" "$FORGED" >/dev/null 2>&1
assert_rc 1 $? "receipt assertion rejects a run in which nothing executed"

forge '.ran = 1 | .checks_run = []'
"$PKG/bin/assert-ci-receipt" "$D" "$FORGED" >/dev/null 2>&1
assert_rc 1 $? "receipt assertion rejects ran>0 with no executed check recorded"

forge '.exit_code = 1'
"$PKG/bin/assert-ci-receipt" "$D" "$FORGED" >/dev/null 2>&1
assert_rc 1 $? "receipt assertion rejects a failing exit_code"

# The control: an unaltered copy through the same path still passes, so the
# rejections above are the altered value and not the copying.
cp "$REAL" "$FORGED"
"$PKG/bin/assert-ci-receipt" "$D" "$FORGED" >/dev/null 2>&1
assert_rc 0 $? "receipt assertion still passes on an unaltered copy"

rm -rf "$D"

# §2.1/§2.2: an enabled configuration in which no check executes is exit 2.
# This is separate from a missing implementation: all configured checks are
# deliberately disabled, so the runner must not call that clean.
say "selftest: empty execution and empty corpus"
D="$(mk_repo)"
cat > "$D/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": { "no-agent-worktrees-tracked": { "enabled": false, "mode": "blocking",
    "patterns": [".claude/worktrees"] } } }
JSON
stamp_repo "$D"
git -C "$D" add -A >/dev/null; git -C "$D" commit -qm cfg
"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 2 $? "ran 0 checks is exit 2"
jq -e '.ran == 0 and .exit_code == 2 and (.checks_skipped[0].reason == "disabled in config")' \
  "$D/checks/.last-run.json" >/dev/null 2>&1
assert_rc 0 $? "ran-0 receipt records the skip reason and exit 2"

# A tiny disposable package supplies a check that falsely reports a clean empty
# corpus. The runner must turn that false pass into exit 2, independently of the
# check's own implementation.
ZROOT="$(mktemp -d)"; ZPKG="$ZROOT/pkg"; ZREPO="$(mktemp -d)"
mkdir -p "$ZPKG"; cp -R "$PKG/bin" "$PKG/sh" "$ZPKG/"
sed -i 's|^AIDE_CHECKS_BUILT_FROM=.*|AIDE_CHECKS_BUILT_FROM="zero-fixture"|' "$ZPKG/bin/run-checks"
cat > "$ZPKG/sh/zero-check" <<'SH'
#!/usr/bin/env bash
echo 'aide-checks: check-result name=zero-check units=0 findings=0 suppressions=0'
exit 0
SH
chmod +x "$ZPKG/sh/zero-check"
git init -q "$ZREPO"; git -C "$ZREPO" config user.email t@t; git -C "$ZREPO" config user.name t
printf '# empty fixture\n' > "$ZREPO/README.md"
mkdir -p "$ZREPO/checks"
printf 'zero-fixture\n' > "$ZREPO/checks/.aide-checks-rev"
cat > "$ZREPO/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": { "zero-check": { "enabled": true, "mode": "blocking" } } }
JSON
git -C "$ZREPO" add -A; git -C "$ZREPO" commit -qm cfg
"$ZPKG/bin/run-checks" --full --repo="$ZREPO" >/dev/null 2>&1
assert_rc 2 $? "zero findings over zero examined units is exit 2"
jq -e '.checks_run[0].units_examined == 0 and .checks_run[0].findings == 0 and .exit_code == 2' \
  "$ZREPO/checks/.last-run.json" >/dev/null 2>&1
assert_rc 0 $? "empty-corpus receipt records zero units and exit 2"
rm -rf "$ZROOT" "$ZREPO" "$D"

# ══════════════════════════════════════════════════════════════════════════
# The revision assertion (spec §2). AP-R10 applies to it exactly as it does to
# a check: it counts only when it is proven it can fail. Proven three times,
# because the claim is that no mode escapes it — --report-only included.
say "selftest: revision assertion"
D="$(mk_repo)"
cat > "$D/checks.config.json" <<'JSON'
{ "stack": "python",
  "checks": { "no-agent-worktrees-tracked": { "enabled": true, "mode": "blocking",
    "patterns": [".claude/worktrees"] } } }
JSON
stamp_repo "$D"
git -C "$D" add -A >/dev/null; git -C "$D" commit -qm cfg

"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 0 $? "matching revision runs normally"

# 3. plant — a deliberately mismatched vendored revision
stamp_repo "$D" "0000dead"
for m in --fast --full --report-only; do
  OUT="$("$PKG/bin/run-checks" $m --repo="$D" 2>&1)"; RC=$?
  assert_rc 2 $RC "mismatched revision is exit 2 in ${m}"
done

# the message has to be actionable: both revisions and the command that fixes it
OUT="$("$PKG/bin/run-checks" --full --repo="$D" 2>&1)"
printf '%s' "$OUT" | grep -q '0000dead' \
  && { say "    ok    message names the vendored revision"; PASS=$((PASS+1)); } \
  || { say "    FAIL  message does not name the vendored revision"; FAIL=$((FAIL+1)); }
printf '%s' "$OUT" | grep -q "$PKG_REV" \
  && { say "    ok    message names the running revision"; PASS=$((PASS+1)); } \
  || { say "    FAIL  message does not name the running revision"; FAIL=$((FAIL+1)); }
printf '%s' "$OUT" | grep -q 'sync-into-repo' \
  && { say "    ok    message names the sync command that fixes it"; PASS=$((PASS+1)); } \
  || { say "    FAIL  message does not name the fix command"; FAIL=$((FAIL+1)); }

# report-only must not soften it to a reported failure: exit 2, and no findings
OUT="$("$PKG/bin/run-checks" --report-only --repo="$D" 2>&1)"
printf '%s' "$OUT" | grep -q 'report-only — exiting 0' \
  && { say "    FAIL  --report-only swallowed the mismatch"; FAIL=$((FAIL+1)); } \
  || { say "    ok    --report-only does not swallow the mismatch"; PASS=$((PASS+1)); }

# no bypass. Any env var that turned this off would be the defect it prevents.
OUT="$(AIDE_CHECKS_SKIP=1 AIDE_CHECKS_SKIP_REVISION=1 AIDE_CHECKS_REV_SKIP=1 \
       "$PKG/bin/run-checks" --full --repo="$D" 2>&1)"; RC=$?
assert_rc 2 $RC "no environment variable bypasses the assertion"

# a repo configured for aide-checks with no vendored revision at all
rm -rf "$D/checks"
"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 2 $? "a missing vendored revision is exit 2, not a silent pass"

# 5. remove the plant
stamp_repo "$D"
"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 0 $? "correct revision restored, run-checks passes again"

# The stamp has to live in the CODE, not only beside it. This is the drift the
# sidecar alone cannot see: checks/bin replaced from an older clone while
# .aide-checks-rev stays current. Simulated by stamping a copied runner.
V="$(mktemp -d)/vendored"
mkdir -p "$V"; cp -R "$PKG/bin" "$PKG/sh" "$PKG/config" "$V/"
sed -i 's|^AIDE_CHECKS_BUILT_FROM=.*|AIDE_CHECKS_BUILT_FROM="0000dead"|' "$V/bin/run-checks"
"$V/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 2 $? "a stale runner is caught by its own stamp, not by the sidecar"
# A runner and working tree can agree while the committed checks directory is
# stale. That is the phase-2 failure mode §2.4 exists to catch.
sed -i "s|^AIDE_CHECKS_BUILT_FROM=.*|AIDE_CHECKS_BUILT_FROM=\"$PKG_REV\"|" "$V/bin/run-checks"
stamp_repo "$D" "0000dead"
git -C "$D" add checks/.aide-checks-rev; git -C "$D" commit -qm old-committed-revision
stamp_repo "$D"
"$V/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 2 $? "vendored revision differing from committed HEAD is exit 2"
OUT="$("$V/bin/run-checks" --full --repo="$D" 2>&1)"
printf '%s' "$OUT" | grep -q 'vendored working tree revision' \
  && { say "    ok    divergence names the working vendored revision"; PASS=$((PASS+1)); } \
  || { say "    FAIL  divergence omits the working vendored revision"; FAIL=$((FAIL+1)); }
printf '%s' "$OUT" | grep -q 'revision committed at HEAD' \
  && { say "    ok    divergence names the committed revision"; PASS=$((PASS+1)); } \
  || { say "    FAIL  divergence omits the committed revision"; FAIL=$((FAIL+1)); }

# A normal adoption commit stages the new marker while HEAD still contains the
# old one. The pre-commit hook must validate the staged claim; otherwise the
# assertion makes the first commit of every runner revision impossible. The
# unstaged case above remains the HEAD comparison that catches current working
# tree content beside a stale commit.
stamp_repo "$D"
git -C "$D" add checks/.aide-checks-rev
"$PKG/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 0 $? "a staged vendored revision is compared against the index"
jq -e --arg rev "$PKG_REV" '.committed_revision == $rev' \
  "$D/checks/.last-run.json" >/dev/null 2>&1
assert_rc 0 $? "receipt records the staged committed revision"
git -C "$D" reset -q HEAD -- checks/.aide-checks-rev
stamp_repo "$D" "0000dead"
sed -i 's|^AIDE_CHECKS_BUILT_FROM=.*|AIDE_CHECKS_BUILT_FROM="0000dead"|' "$V/bin/run-checks"
"$V/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 0 $? "the same runner passes against a repo vendored at its own revision"

# a runner carrying no revision at all cannot be told from a stale one
sed -i 's|^AIDE_CHECKS_BUILT_FROM=.*|AIDE_CHECKS_BUILT_FROM="__AIDE_CHECKS_REV__"|' "$V/bin/run-checks"
"$V/bin/run-checks" --full --repo="$D" >/dev/null 2>&1
assert_rc 2 $? "an unstamped runner outside a git checkout is exit 2"
rm -rf "$V" "$D"

# ══════════════════════════════════════════════════════════════════════════
# The phase-3 report-only checks. Each one gets a clean fixture, a planted
# violation, and a restored clean run. These fixtures scan source or metadata
# only; they never execute a deploy, open a live database, or use a credential.
say "selftest: identifier-hygiene"
D="$(mk_repo)"
mkdir -p "$D/frontend/src"
cat > "$D/frontend/src/App.jsx" <<'EOF'
export function App() {
  return <button label="Ready">Ready</button>;
}
EOF
cat > "$D/checks.config.json" <<'JSON'
{
  "stack": "node",
  "checks": {
    "identifier-hygiene": {
      "enabled": true,
      "mode": "report-only",
      "scope": {"frontend/src/**": "disposable React user-facing fixture"},
      "scope_source": "selftest fixture declares its only UI surface",
      "internal_terms": {"Layer 1": "fixture vocabulary used to prove a configured term is reported"},
      "internal_terms_source": "selftest fixture term, authored before the scan"
    }
  }
}
JSON
git -C "$D" add -A; git -C "$D" commit -qm identifier-baseline
"$PKG/py/identifier-hygiene" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "identifier-hygiene clean fixture passes"
printf 'const label = "Layer 1";\n' >> "$D/frontend/src/App.jsx"
printf 'const internal = "RAW_IDENTIFIER";\n' >> "$D/frontend/src/App.jsx"
"$PKG/py/identifier-hygiene" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 1 $? "identifier-hygiene planted term and enum are reported"
grep -q 'Layer 1' "$D/checks/IDENTIFIER-FINDINGS.md" \
  && { say "    ok    identifier finding records configured term"; PASS=$((PASS+1)); } \
  || { say "    FAIL  identifier finding omits configured term"; FAIL=$((FAIL+1)); }
cat > "$D/frontend/src/App.jsx" <<'EOF'
export function App() {
  return <button label="Ready">Ready</button>;
}
EOF
"$PKG/py/identifier-hygiene" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "identifier-hygiene plant removed, clean fixture returns"
rm -rf "$D"

say "selftest: deploy-preflight"
D="$(mk_repo)"
cat > "$D/deploy.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
TOKEN="${TOKEN:?required}"
curl -fsS https://example.invalid/health >/dev/null
EOF
chmod +x "$D/deploy.sh"
cat > "$D/checks.config.json" <<'JSON'
{
  "stack": "mixed",
  "checks": {
    "deploy-preflight": {
      "enabled": true,
      "mode": "report-only",
      "script": "deploy.sh",
      "script_reason": "the disposable fixture's only deploy boundary",
      "secret_names": {"TOKEN": "disposable secret input"},
      "secret_names_source": "the fixture script declares TOKEN as its only secret input",
      "non_fatal_patterns": {},
      "non_fatal_source": "the fixture declares no deliberately non-fatal external step"
    }
  }
}
JSON
git -C "$D" add -A; git -C "$D" commit -qm deploy-baseline
"$PKG/py/deploy-preflight" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "deploy-preflight clean fixture passes"
git -C "$D" add checks/DEPLOY-FINDINGS.md; git -C "$D" commit -qm deploy-report >/dev/null
printf 'TOKEN="retired-value"\n' >> "$D/deploy.sh"
git -C "$D" add deploy.sh; git -C "$D" commit -qm hardcoded-token >/dev/null
"$PKG/py/deploy-preflight" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 1 $? "deploy-preflight reports a hardcoded credential-shaped assignment"
sed -i '/retired-value/d' "$D/deploy.sh"
printf 'echo "${TOKEN:-retired-value}"\n' >> "$D/deploy.sh"
git -C "$D" add deploy.sh; git -C "$D" commit -qm fallback-token >/dev/null
"$PKG/py/deploy-preflight" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 1 $? "deploy-preflight reports a secret fallback default"
rm -rf "$D"

say "selftest: stale-worktrees"
D="$(mk_repo)"
cat > "$D/checks.config.json" <<'JSON'
{
  "stack": "mixed",
  "checks": {
    "stale-worktrees": {
      "enabled": true,
      "mode": "report-only",
      "max_age_days": 7,
      "max_age_reason": "the fixture uses one week as the stale-work threshold",
      "age_source": "worktree directory mtime is the available local age signal",
      "include_main": false,
      "include_main_reason": "the primary checkout is active work, not a stranded linked worktree"
    }
  }
}
JSON
git -C "$D" add -A; git -C "$D" commit -qm worktree-baseline
"$PKG/py/stale-worktrees" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 0 $? "stale-worktrees clean main worktree passes"
git -C "$D" add checks/WORKTREE-FINDINGS.md; git -C "$D" commit -qm worktree-report >/dev/null
W="$D/linked-stale"
git -C "$D" worktree add -q -b stale-fixture "$W"
touch -d '30 days ago' "$W"
"$PKG/py/stale-worktrees" "$D" "$D/checks.config.json" >/dev/null 2>&1
assert_rc 1 $? "stale-worktrees reports an old unpushed linked worktree"
git -C "$D" worktree remove -f "$W" >/dev/null
rm -rf "$D"

# ══════════════════════════════════════════════════════════════════════════
# rls-policy-present.
#
# THIS SELFTEST MUST NOT TOUCH A LIVE DATABASE (spec §5). It starts a postgres
# of its own and drops it again — a disposable server, which is strictly more
# than the disposable schema §5 asks for, and it creates and drops a uniquely
# named schema inside it as well.
#
# The reason is on the record: accounting's production database was destroyed on
# 2026-08-24 by a committed test running `DROP SCHEMA public CASCADE`. A selftest
# that reaches a real database is that defect waiting to recur. So:
#   * every ambient connection variable is unset before the check is invoked —
#     the only one set is the URL of the server this selftest started;
#   * the initdb path listens on a unix socket with listen_addresses='' , so it
#     has no TCP port and cannot be confused with anything running;
#   * nothing here runs DROP SCHEMA against a schema the selftest did not create.
say "selftest: rls-policy-present"

PGTMP=""; PGCID=""; PGBIN=""
rls_teardown() {
  [ -n "$PGCID" ] && docker rm -f "$PGCID" >/dev/null 2>&1
  [ -n "$PGBIN" ] && [ -n "$PGTMP" ] && "$PGBIN/pg_ctl" -D "$PGTMP/data" -m immediate -w stop >/dev/null 2>&1
  [ -n "$PGTMP" ] && rm -rf "$PGTMP"
  PGCID=""; PGBIN=""; PGTMP=""
}
trap rls_teardown EXIT

DBURL=""
PGBIN_CAND="$(ls -d /usr/lib/postgresql/*/bin 2>/dev/null | sort -V | tail -1)"
if [ -n "$PGBIN_CAND" ] && [ -x "$PGBIN_CAND/initdb" ]; then
  PGTMP="$(mktemp -d)"; mkdir -p "$PGTMP/sock"
  # The port is pinned on both sides rather than left to a default. On Debian
  # and Ubuntu the postgresql-common client wrapper reports a default port taken
  # from the host's own cluster (5438 here) while the server binaries use the
  # compiled 5432, so an unpinned socket is named by one number and looked for
  # under the other. It is a socket in our own temp directory; the number is
  # only a filename suffix and cannot collide.
  if "$PGBIN_CAND/initdb" -D "$PGTMP/data" -U aide_selftest -A trust -E UTF8 --no-sync >/dev/null 2>&1 \
     && "$PGBIN_CAND/pg_ctl" -D "$PGTMP/data" -l "$PGTMP/log" -w -t 30 \
          -o "-k $PGTMP/sock -h '' -p 5432 -c fsync=off" start >/dev/null 2>&1 \
     && "$PGBIN_CAND/createdb" -h "$PGTMP/sock" -p 5432 -U aide_selftest aide_selftest >/dev/null 2>&1; then
    PGBIN="$PGBIN_CAND"
    DBURL="postgresql://aide_selftest@/aide_selftest?host=$PGTMP/sock&port=5432"
    say "    (disposable cluster: local initdb, unix socket only, no TCP port)"
  else
    rm -rf "$PGTMP"; PGTMP=""
  fi
fi
if [ -z "$DBURL" ] && command -v docker >/dev/null 2>&1 && docker ps >/dev/null 2>&1; then
  PGCID="$(docker run --rm -d -e POSTGRES_PASSWORD=aide_selftest -e POSTGRES_USER=aide_selftest \
             -e POSTGRES_DB=aide_selftest -p 127.0.0.1::5432 postgres:16-alpine 2>/dev/null)"
  if [ -n "$PGCID" ]; then
    PGPORT_T="$(docker port "$PGCID" 5432/tcp 2>/dev/null | head -1 | sed 's/.*://')"
    for _ in $(seq 1 60); do
      docker exec "$PGCID" pg_isready -U aide_selftest -d aide_selftest >/dev/null 2>&1 && break
      sleep 1
    done
    [ -n "$PGPORT_T" ] && DBURL="postgres://aide_selftest:aide_selftest@127.0.0.1:${PGPORT_T}/aide_selftest"
    say "    (disposable cluster: throwaway container ${PGCID:0:12} on 127.0.0.1:${PGPORT_T})"
  fi
fi

if [ -z "$DBURL" ]; then
  # Not a skip. AP-R10: a check counts only when the packet proves it can fail,
  # and an unproven check is not vendored anywhere.
  say "    FAIL  no disposable postgres available (need local initdb or docker);"
  say "          rls-policy-present cannot be proven able to fail on this host"
  FAIL=$((FAIL+1))
else
  SCH="aide_checks_selftest_$$"
  # Every invocation runs with the ambient connection environment stripped. The
  # check reads its connection from the environment and has no fallback literal;
  # this is what makes "no live database" a property of the selftest, not a hope.
  # ON_ERROR_STOP plus an explicit rc assertion: a fixture that fails to build is
  # the quietest way to get a green line for the wrong reason. `AS RESTRICTIVE`
  # in the wrong clause position did exactly that here before this was added.
  q() { env -u PGHOST -u PGPORT -u PGUSER -u PGPASSWORD -u PGDATABASE -u PGSERVICE \
          psql "$DBURL" -X -q -v ON_ERROR_STOP=1 -At --no-psqlrc \
          -c "SET client_min_messages = warning;" -c "$1"; }
  fixture() { q "$1" >/dev/null || { say "    FAIL  fixture SQL did not apply: $2"; FAIL=$((FAIL+1)); }; }
  run_rls() { env -u DATABASE_URL -u PGHOST -u PGPORT -u PGUSER -u PGPASSWORD -u PGDATABASE \
                AIDE_CHECKS_DATABASE_URL="$DBURL" "$PKG/sh/rls-policy-present" "$RD" "$RD/checks.config.json"; }

  RD="$(mktemp -d)"
  # `${1:-'{}'}` emits the single quotes into the JSON, so an omitted argument
  # produced a config that does not parse. jq then returned nothing, the check
  # saw no schemas and exited 2 — and three exit-2 assertions went green on a
  # broken fixture rather than on the behaviour they name. Hence the jq empty
  # guard below: a fixture that fails to build is the quietest way to get a
  # green line for the wrong reason.
  rls_cfg() { # rls_cfg [global_vocabulary_tables json] [exempt_tables json]
    local gv="${1:-}" ex="${2:-}"
    [ -n "$gv" ] || gv='{}'
    [ -n "$ex" ] || ex='{}'
    cat > "$RD/checks.config.json" <<JSON
{ "stack": "python",
  "checks": { "rls-policy-present": {
    "enabled": true, "mode": "report-only", "fast": false,
    "connection_env": ["AIDE_CHECKS_DATABASE_URL"],
    "schemas": ["$SCH"],
    "tenant_columns": ["institution_id", "course_id", "team_id"],
    "context_function_pattern": "selftest_ctx\\\\.current_[a-z_]+\\\\(\\\\)",
    "global_vocabulary_tables": $gv,
    "global_vocabulary_source": "selftest fixture: the set is stated, never inferred",
    "exempt_tables": $ex
  } } }
JSON
    jq empty "$RD/checks.config.json" 2>/dev/null || {
      say "    FAIL  fixture config is not valid JSON — any assertion after this is meaningless"
      FAIL=$((FAIL+1)); }
  }

  q "CREATE SCHEMA \"$SCH\";" >/dev/null
  q "CREATE SCHEMA selftest_ctx;" >/dev/null
  q "CREATE FUNCTION selftest_ctx.current_institution_id() RETURNS bigint LANGUAGE sql STABLE
     AS \$\$ SELECT NULLIF(current_setting('app.inst', true), '')::bigint \$\$;" >/dev/null

  # a scoped table, correctly policed, and a global vocabulary table with the
  # explicit authenticated policy the rule asks for
  q "CREATE TABLE \"$SCH\".scoped (id bigserial primary key, institution_id bigint not null);
     ALTER TABLE \"$SCH\".scoped ENABLE ROW LEVEL SECURITY;
     CREATE POLICY p_scoped ON \"$SCH\".scoped FOR ALL TO PUBLIC
       USING (institution_id = selftest_ctx.current_institution_id());
     CREATE TABLE \"$SCH\".vocab (id bigserial primary key, term text not null);
     ALTER TABLE \"$SCH\".vocab ENABLE ROW LEVEL SECURITY;
     CREATE POLICY p_vocab ON \"$SCH\".vocab FOR SELECT TO PUBLIC
       USING (selftest_ctx.current_institution_id() IS NOT NULL);" >/dev/null

  rls_cfg '{"vocab": "selftest fixture: the shared term list, no tenant scope"}'
  run_rls >/dev/null 2>&1
  assert_rc 0 $? "clean disposable schema passes"

  # ── A1: a table with no policy ────────────────────────────────────────────
  q "CREATE TABLE \"$SCH\".unpoliced (id bigserial primary key, institution_id bigint);" >/dev/null
  OUT="$(run_rls 2>&1)"; RC=$?
  assert_rc 1 $RC "A1: a table with no RLS policy fails"
  printf '%s' "$OUT" | grep -q "${SCH}.unpoliced" \
    && { say "    ok    A1 finding names the table"; PASS=$((PASS+1)); } \
    || { say "    FAIL  A1 finding does not name the table"; FAIL=$((FAIL+1)); }

  # RLS enabled but still no policy is the same violation — enabling RLS without
  # a policy denies everything and asserts nothing.
  q "ALTER TABLE \"$SCH\".unpoliced ENABLE ROW LEVEL SECURITY;" >/dev/null
  run_rls >/dev/null 2>&1
  assert_rc 1 $? "A1: RLS enabled with no policy still fails"

  q "CREATE POLICY p_u ON \"$SCH\".unpoliced FOR ALL TO PUBLIC
       USING (institution_id = selftest_ctx.current_institution_id());" >/dev/null
  run_rls >/dev/null 2>&1
  assert_rc 0 $? "A1: policy added, check passes again"

  # ── A2a: global vocabulary without an authenticated/global policy ─────────
  # USING (true) is global but NOT authenticated. This is the distinction the
  # rule turns on, and the one a looser check would miss.
  q "DROP POLICY p_vocab ON \"$SCH\".vocab;
     CREATE POLICY p_vocab ON \"$SCH\".vocab FOR SELECT TO PUBLIC USING (true);" >/dev/null
  OUT="$(run_rls 2>&1)"; RC=$?
  assert_rc 1 $RC "A2a: USING (true) is not an authenticated policy"
  printf '%s' "$OUT" | grep -q 'p_vocab' \
    && { say "    ok    A2a finding names the policy it judged"; PASS=$((PASS+1)); } \
    || { say "    FAIL  A2a finding does not name the policy"; FAIL=$((FAIL+1)); }

  # USING (false) — the deny-all default a per-tenant loop leaves behind
  q "DROP POLICY p_vocab ON \"$SCH\".vocab;
     CREATE POLICY p_vocab ON \"$SCH\".vocab FOR ALL TO PUBLIC USING (false);" >/dev/null
  run_rls >/dev/null 2>&1
  assert_rc 1 $? "A2a: the deny-all USING (false) default fails"

  # A RESTRICTIVE policy naming the context function is not a grant of access —
  # it only narrows one. The finding must still be A2a (policies exist, none of
  # them authenticated/global), not A1 (no policy at all): if the fixture failed
  # to apply, the table would have no policy and this would pass for the wrong
  # reason. That is why the finding shape is asserted, not just the exit code.
  fixture "DROP POLICY p_vocab ON \"$SCH\".vocab;
     CREATE POLICY p_vocab ON \"$SCH\".vocab AS RESTRICTIVE FOR SELECT TO PUBLIC
       USING (selftest_ctx.current_institution_id() IS NOT NULL);" "restrictive policy"
  OUT="$(run_rls 2>&1)"; RC=$?
  assert_rc 1 $RC "A2a: a restrictive policy does not satisfy the clause"
  printf '%s' "$OUT" | grep -q 'A2a' \
    && { say "    ok    reported as A2a, not as a missing policy"; PASS=$((PASS+1)); } \
    || { say "    FAIL  restrictive-policy case was not reported as A2a"; FAIL=$((FAIL+1)); }

  q "DROP POLICY p_vocab ON \"$SCH\".vocab;
     CREATE POLICY p_vocab ON \"$SCH\".vocab FOR SELECT TO PUBLIC
       USING (selftest_ctx.current_institution_id() IS NOT NULL);" >/dev/null
  run_rls >/dev/null 2>&1
  assert_rc 0 $? "A2a: the explicit authenticated policy passes"

  # ── A2b: a tenant column on a global vocabulary table ─────────────────────
  q "ALTER TABLE \"$SCH\".vocab ADD COLUMN institution_id bigint;" >/dev/null
  OUT="$(run_rls 2>&1)"; RC=$?
  assert_rc 1 $RC "A2b: a tenant column on a global vocabulary table fails"
  printf '%s' "$OUT" | grep -q 'institution_id' \
    && { say "    ok    A2b finding names the column"; PASS=$((PASS+1)); } \
    || { say "    FAIL  A2b finding does not name the column"; FAIL=$((FAIL+1)); }
  q "ALTER TABLE \"$SCH\".vocab DROP COLUMN institution_id;" >/dev/null
  run_rls >/dev/null 2>&1
  assert_rc 0 $? "A2b: column dropped, check passes again"

  # ── exempt_tables ─────────────────────────────────────────────────────────
  # The load-bearing property is the same one allow_fields has: it suppresses
  # ONE named thing for a recorded reason, and it does not become a way to turn
  # the check off. Every assertion below exists to prove the rest still fires.
  fixture "CREATE TABLE \"$SCH\".ctxless (id bigserial primary key, k text);" "exempt fixture"
  OUT="$(run_rls 2>&1)"; RC=$?
  assert_rc 1 $RC "baseline: the new policy-less table is reported"

  rls_cfg '{"vocab": "selftest fixture"}' '{"ctxless": "selftest fixture: written on a context-less path, a policy keyed to a context function would match zero rows"}'
  OUT="$(run_rls 2>&1)"; RC=$?
  assert_rc 0 $RC "an exempt table is suppressed"
  printf '%s' "$OUT" | grep -q 'suppressed by exempt_tables' \
    && { say "    ok    the exemption is reported, not silent"; PASS=$((PASS+1)); } \
    || { say "    FAIL  the exemption was silent"; FAIL=$((FAIL+1)); }

  # THE ONE THAT MATTERS: exempting one table must not exempt any other.
  fixture "CREATE TABLE \"$SCH\".other_unpoliced (id bigserial primary key);" "second policy-less table"
  OUT="$(run_rls 2>&1)"; RC=$?
  assert_rc 1 $RC "a DIFFERENT policy-less table still fails while one is exempt"
  printf '%s' "$OUT" | grep -q "${SCH}.other_unpoliced" \
    && { say "    ok    the still-reported table is named"; PASS=$((PASS+1)); } \
    || { say "    FAIL  the second table was wrongly suppressed"; FAIL=$((FAIL+1)); }
  fixture "DROP TABLE \"$SCH\".other_unpoliced;" "drop second table"

  # an exemption does NOT reach the global-vocabulary clauses
  fixture "DROP POLICY p_vocab ON \"$SCH\".vocab;
     CREATE POLICY p_vocab ON \"$SCH\".vocab FOR SELECT TO PUBLIC USING (true);" "vocab open policy"
  rls_cfg '{"vocab": "selftest fixture"}' '{"vocab": "attempt to exempt a global vocabulary table"}'
  run_rls >/dev/null 2>&1
  assert_rc 2 $? "a table in both exempt_tables and global_vocabulary_tables is exit 2"
  fixture "DROP POLICY p_vocab ON \"$SCH\".vocab;
     CREATE POLICY p_vocab ON \"$SCH\".vocab FOR SELECT TO PUBLIC
       USING (selftest_ctx.current_institution_id() IS NOT NULL);" "vocab authenticated policy"

  rls_cfg '{"vocab": "selftest fixture"}' '{"ctxless": ""}'
  run_rls >/dev/null 2>&1
  assert_rc 2 $? "an exemption with no reason is exit 2, not a silent allow"

  rls_cfg '{"vocab": "selftest fixture"}' '{"no_such_table": "configured but gone"}'
  run_rls >/dev/null 2>&1
  assert_rc 2 $? "an exemption naming a table that is not scanned is exit 2"

  # a stale exemption — the table acquired a policy — is reported, not failed
  fixture "CREATE POLICY p_ctxless ON \"$SCH\".ctxless FOR ALL TO PUBLIC
             USING (selftest_ctx.current_institution_id() IS NOT NULL);
           ALTER TABLE \"$SCH\".ctxless ENABLE ROW LEVEL SECURITY;" "policy on the exempt table"
  rls_cfg '{"vocab": "selftest fixture"}' '{"ctxless": "selftest fixture: reason recorded"}'
  OUT="$(run_rls 2>&1)"; RC=$?
  assert_rc 0 $RC "an exemption that suppresses nothing does not fail the check"
  printf '%s' "$OUT" | grep -q 'no longer suppress anything' \
    && { say "    ok    a stale exemption is reported as stale"; PASS=$((PASS+1)); } \
    || { say "    FAIL  a stale exemption was silent"; FAIL=$((FAIL+1)); }
  fixture "DROP TABLE \"$SCH\".ctxless;" "drop exempt fixture"
  rls_cfg '{"vocab": "selftest fixture"}'

  # ── could-not-run cases. Each of these would otherwise be a silent pass. ──
  env -u DATABASE_URL -u AIDE_CHECKS_DATABASE_URL "$PKG/sh/rls-policy-present" \
      "$RD" "$RD/checks.config.json" >/dev/null 2>&1
  assert_rc 2 $? "no connection in the environment is exit 2, not a pass"

  env AIDE_CHECKS_DATABASE_URL="postgres://nobody@127.0.0.1:1/nothing" \
      "$PKG/sh/rls-policy-present" "$RD" "$RD/checks.config.json" >/dev/null 2>&1
  assert_rc 2 $? "an unreachable database is exit 2, not a pass"

  rls_cfg '{"vocab": ""}'
  run_rls >/dev/null 2>&1
  assert_rc 2 $? "a global vocabulary table with no reason is exit 2"

  rls_cfg '{"no_such_table": "configured but gone"}'
  run_rls >/dev/null 2>&1
  assert_rc 2 $? "a configured global vocabulary table that does not exist is exit 2"

  rls_cfg '{"vocab": "selftest fixture"}'
  python3 - "$RD/checks.config.json" <<'PY'
import json,sys
c=json.load(open(sys.argv[1])); c["checks"]["rls-policy-present"]["global_vocabulary_source"]=""
json.dump(c,open(sys.argv[1],"w"),indent=2)
PY
  run_rls >/dev/null 2>&1
  assert_rc 2 $? "an unrecorded global_vocabulary_source is exit 2"

  rls_cfg '{"vocab": "selftest fixture"}'
  python3 - "$RD/checks.config.json" <<'PY'
import json,sys
c=json.load(open(sys.argv[1])); c["checks"]["rls-policy-present"]["context_function_pattern"]=""
json.dump(c,open(sys.argv[1],"w"),indent=2)
PY
  run_rls >/dev/null 2>&1
  assert_rc 2 $? "no context_function_pattern is exit 2, not a pass on any policy"

  rls_cfg '{}'
  python3 - "$RD/checks.config.json" <<'PY'
import json,sys
c=json.load(open(sys.argv[1])); c["checks"]["rls-policy-present"]["schemas"]=["aide_checks_no_such_schema"]
json.dump(c,open(sys.argv[1],"w"),indent=2)
PY
  run_rls >/dev/null 2>&1
  assert_rc 2 $? "a schema holding no tables is exit 2 — nothing inspected is not a pass"

  # ── the disposable schema is dropped, and it is the one we created ────────
  q "DROP SCHEMA \"$SCH\" CASCADE; DROP SCHEMA selftest_ctx CASCADE;" >/dev/null
  LEFT="$(q "SELECT count(*) FROM pg_namespace WHERE nspname = '$SCH';")"
  [ "$LEFT" = "0" ] \
    && { say "    ok    the disposable schema was dropped"; PASS=$((PASS+1)); } \
    || { say "    FAIL  the disposable schema outlived the selftest"; FAIL=$((FAIL+1)); }
  rm -rf "$RD"
fi
rls_teardown
trap - EXIT


say ""
say "selftest: ${PASS} passed, ${FAIL} failed"
[ "$FAIL" -eq 0 ] || exit 1
exit 0
