#!/usr/bin/env python3
"""Report old linked worktrees whose work is dirty or not pushed."""

from __future__ import annotations

import json
import subprocess
import sys
import time
from pathlib import Path


CHECK = "stale-worktrees"


def fail(message: str) -> int:
    print(f"{CHECK}: ERROR {message}", file=sys.stderr)
    return 2


def load(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        cfg = data["checks"][CHECK]
    except (OSError, ValueError, KeyError, TypeError) as exc:
        raise ValueError(f"invalid config: {exc}") from exc
    if not isinstance(cfg, dict):
        raise ValueError(f"{CHECK} configuration is not an object")
    for key in ("max_age_days", "max_age_reason", "age_source", "include_main", "include_main_reason"):
        if key not in cfg:
            raise ValueError(f"{key} is required")
    if cfg.get("mode") != "report-only":
        raise ValueError("stale-worktrees must remain report-only")
    if not isinstance(cfg["max_age_days"], int) or cfg["max_age_days"] < 1:
        raise ValueError("max_age_days must be a positive integer")
    for key in ("max_age_reason", "age_source", "include_main_reason"):
        if not isinstance(cfg[key], str) or not cfg[key].strip():
            raise ValueError(f"{key} requires a stated reason")
    return cfg


def git(repo: Path, *args: str) -> tuple[int, str, str]:
    proc = subprocess.run(
        ["git", "--no-optional-locks", "-C", str(repo), *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def parse_worktrees(repo: Path) -> list[dict]:
    rc, output, err = git(repo, "worktree", "list", "--porcelain")
    if rc:
        raise RuntimeError(err or "could not list worktrees")
    entries: list[dict] = []
    current: dict = {}
    for line in output.splitlines() + [""]:
        if line.startswith("worktree "):
            if current:
                entries.append(current)
            current = {"path": line[9:]}
        elif line.startswith("HEAD "):
            current["head"] = line[5:]
        elif line.startswith("branch "):
            current["branch"] = line[7:].removeprefix("refs/heads/")
        elif line == "detached":
            current["branch"] = "(detached)"
        elif line == "prunable":
            current["prunable"] = True
        elif not line and current:
            entries.append(current)
            current = {}
    return entries


def worktree_details(repo: Path, entry: dict, main_path: Path, max_age_days: int) -> dict:
    path = Path(entry["path"]).resolve()
    is_main = path == main_path
    exists = path.exists()
    dirty = -1
    upstream = "(none)"
    pushed = False
    if exists:
        rc, status, _ = git(path, "status", "--porcelain=v1", "--untracked-files=all")
        dirty = len(status.splitlines()) if rc == 0 and status else 0 if rc == 0 else -1
        rc, value, _ = git(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
        if rc == 0 and value:
            upstream = value
            pushed = git(path, "merge-base", "--is-ancestor", "HEAD", "@{upstream}")[0] == 0
    try:
        age_days = max(0, int((time.time() - path.stat().st_mtime) // 86400)) if exists else max_age_days + 1
    except OSError:
        age_days = max_age_days + 1
    return {
        "path": str(path),
        "branch": entry.get("branch", "(detached)"),
        "dirty": dirty,
        "upstream": upstream,
        "pushed": pushed,
        "age_days": age_days,
        "is_main": is_main,
        "exists": exists,
        "prunable": bool(entry.get("prunable")),
        "stale": False,
    }


def markdown(value: str) -> str:
    return value.replace("|", "\\|").replace("\n", " ")


def write_findings(repo: Path, cfg: dict, details: list[dict], flags: list[dict]) -> None:
    out = repo / "checks" / "WORKTREE-FINDINGS.md"
    rows = [
        "# stale-worktrees findings",
        "",
        "Generated by `aide-checks`; this check is report-only and never deploy-blocking.",
        "",
        f"- Maximum age: {cfg['max_age_days']} days ({cfg['max_age_reason']})",
        f"- Age source: {cfg['age_source']}",
        f"- Main worktree included in stale decision: {cfg['include_main']} ({cfg['include_main_reason']})",
        f"- Units examined: {len(details)}",
        f"- Flags: {len(flags)}",
        "- Deliberate flags: 0; every stale condition is a confirmed housekeeping observation, never a deploy exemption.",
        "",
        "| worktree | branch | dirty files | upstream | pushed | age days | stale condition | adjudication |",
        "|---|---|---:|---|---|---:|---|---|",
    ]
    for item in details:
        rows.append(
            f"| `{markdown(item['path'])}` | `{markdown(item['branch'])}` | {item['dirty']} | "
            f"`{markdown(item['upstream'])}` | {str(item['pushed']).lower()} | {item['age_days']} | "
            f"{'yes' if item['stale'] else 'no'} | {'confirmed stale condition; not deliberately suppressed' if item['stale'] else 'not flagged'} |"
        )
    if not details:
        rows.append("| — | — | — | — | — | — | no registered worktrees | could not run |")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(rows) + "\n", encoding="utf-8")


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        return fail("usage: stale-worktrees <repo root> <config path>")
    repo = Path(argv[1]).resolve()
    config_path = Path(argv[2]).resolve()
    try:
        cfg = load(config_path)
        entries = parse_worktrees(repo)
        main_path = Path(repo).resolve()
    except (ValueError, OSError, RuntimeError) as exc:
        return fail(str(exc))

    details = [worktree_details(repo, entry, main_path, cfg["max_age_days"]) for entry in entries]
    for item in details:
        item["stale"] = (
            (cfg["include_main"] or not item["is_main"])
            and item["age_days"] >= cfg["max_age_days"]
            and (item["dirty"] != 0 or not item["pushed"])
        )
    flags = [item for item in details if item["stale"]]
    try:
        write_findings(repo, cfg, details, flags)
    except OSError as exc:
        return fail(f"could not write checks/WORKTREE-FINDINGS.md: {exc}")

    print(f"aide-checks: check-result name={CHECK} units={len(details)} findings={len(flags)} suppressions=0")
    if not details:
        print(f"{CHECK}: ERROR zero findings over zero examined units — could not run.", file=sys.stderr)
        return 2
    for item in details:
        print(
            f"  {item['path']} branch={item['branch']} dirty={item['dirty']} "
            f"upstream={item['upstream']} pushed={str(item['pushed']).lower()} age_days={item['age_days']}"
        )
    if flags:
        print(f"{CHECK}: REPORT {len(flags)} stale worktree(s)")
        return 1
    print(f"{CHECK}: REPORT 0 stale worktrees")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
