#!/usr/bin/env python3
"""Audit a repository's configured deploy/build boundary without executing it."""

from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path


CHECK = "deploy-preflight"
EXTERNAL_RE = re.compile(r"\b(?:curl|ssh|rsync|scp|sftp|npm|pnpm|yarn|vite|docker|systemctl|git|tar)\b")
ASSIGNMENT_RE = re.compile(r"^\s*(?:export\s+)?(?P<name>[A-Za-z_][A-Za-z0-9_]*)\s*=\s*(?P<value>.*)$")
WARNING_RE = re.compile(r"\bWARNING\b|\bwarn\s*(?:\(|\s)", re.IGNORECASE)


def fail(message: str) -> int:
    print(f"{CHECK}: ERROR {message}", file=sys.stderr)
    return 2


def load(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        cfg = data["checks"][CHECK]
    except (OSError, ValueError, KeyError, TypeError) as exc:
        raise ValueError(f"invalid config: {exc}") from exc
    if not isinstance(cfg, dict):
        raise ValueError("check configuration is not an object")
    for key in ("script", "script_reason", "secret_names", "secret_names_source", "non_fatal_patterns", "non_fatal_source"):
        if key not in cfg:
            raise ValueError(f"{key} is required")
    if not isinstance(cfg["secret_names"], dict) or not isinstance(cfg["non_fatal_patterns"], dict):
        raise ValueError("secret_names and non_fatal_patterns must be objects of entry -> reason")
    for key in ("script_reason", "secret_names_source", "non_fatal_source"):
        if not isinstance(cfg[key], str) or not cfg[key].strip():
            raise ValueError(f"{key} requires a stated reason")
    for entries, label in ((cfg["secret_names"], "secret name"), (cfg["non_fatal_patterns"], "non-fatal pattern")):
        for item, reason in entries.items():
            if not isinstance(item, str) or not item or not isinstance(reason, str) or not reason.strip():
                raise ValueError(f"every {label} requires a stated reason")
    return cfg


def shell_parameter_default(line: str, name: str) -> list[str]:
    """Return defaults in ${NAME:-default}/${NAME-default}, including nesting."""
    starts = ["${" + name + ":-", "${" + name + "-"]
    defaults: list[str] = []
    for marker in starts:
        pos = 0
        while True:
            start = line.find(marker, pos)
            if start < 0:
                break
            cursor = start + len(marker)
            depth = 1
            while cursor < len(line) and depth:
                if line.startswith("${", cursor):
                    depth += 1
                    cursor += 2
                    continue
                if line[cursor] == "}":
                    depth -= 1
                cursor += 1
            if depth == 0:
                defaults.append(line[start + len(marker) : cursor - 1])
            pos = max(cursor, start + 1)
    return defaults


def literal_default(value: str) -> bool:
    value = value.strip()
    if not value:
        return False
    # A nested environment expansion is not a hardcoded fallback. Any
    # remaining path, word, or literal after expansions is a default value.
    value = re.sub(r"\$\{[A-Za-z_][A-Za-z0-9_]*(?::[-?][^{}]*)?\}", "", value)
    value = re.sub(r"\$[A-Za-z_][A-Za-z0-9_]*", "", value)
    return bool(re.sub(r"[\s{}:?,\-]", "", value))


def status_lines(repo: Path) -> list[str]:
    proc = subprocess.run(
        ["git", "--no-optional-locks", "-C", str(repo), "status", "--porcelain=v1", "--untracked-files=all"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode:
        raise RuntimeError(proc.stderr.strip() or "not a git repository")
    return [line for line in proc.stdout.splitlines() if line]


def markdown(value: str) -> str:
    return value.replace("|", "\\|").replace("\n", " ")


def shell_code(line: str) -> str:
    """Return a conservative code-only view for line-local shell checks."""
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return ""
    if stripped.startswith(("//", "/*", "*", "<!--")):
        return ""
    return line


def write_findings(repo: Path, cfg: dict, flags: list[dict], units: int, suppressions: int) -> None:
    out = repo / "checks" / "DEPLOY-FINDINGS.md"
    rows = [
        "# deploy-preflight findings",
        "",
        "Generated by `aide-checks`; this check is report-only. Each emitted observation below is adjudicated as confirmed; promotion remains a separate owner decision.",
        "",
        f"- Deploy boundary: `{cfg['script']}`",
        f"- Units examined: {units}",
        f"- Flags: {len(flags)}",
        f"- Declared non-fatal observations: {suppressions}",
        "- Deliberate flags: 0; configured non-fatal observations are counted separately as suppressions with reasons.",
        f"- Script source: {cfg['script_reason']}",
        f"- Secret-name source: {cfg['secret_names_source']}",
        f"- Non-fatal declaration source: {cfg['non_fatal_source']}",
        "",
        "| line | category | adjudication |",
        "|---:|---|---|",
    ]
    for flag in flags:
        detail = f" — {flag['detail']}" if flag.get("detail") else ""
        if flag["category"] == "dirty-tree-including-untracked":
            adjudication = "confirmed baseline workspace state; no script exemption"
        else:
            adjudication = "confirmed configured-script observation; not deliberately suppressed"
        rows.append(f"| {flag['line']} | {markdown(flag['category'])}{markdown(detail)} | {adjudication} |")
    if not flags:
        rows.append("| — | zero flags; suspect count | investigate before treating as clean |")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(rows) + "\n", encoding="utf-8")


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        return fail("usage: deploy-preflight <repo root> <config path>")
    repo = Path(argv[1]).resolve()
    config_path = Path(argv[2]).resolve()
    try:
        cfg = load(config_path)
        script = Path(cfg["script"])
        script_path = script if script.is_absolute() else repo / script
        statuses = status_lines(repo)
    except (ValueError, OSError, RuntimeError) as exc:
        return fail(str(exc))

    flags: list[dict] = []
    suppressions = 0
    if not script_path.is_file():
        flags.append({"line": 0, "category": "missing-configured-deploy-script"})
        text = ""
    else:
        try:
            text = script_path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            return fail(f"could not read configured deploy script: {exc}")

    secret_names = set(cfg["secret_names"])
    lines = text.splitlines()
    for line_no, line in enumerate(lines, 1):
        code = shell_code(line)
        if not code:
            continue
        assignment = ASSIGNMENT_RE.match(line)
        if assignment and assignment.group("name") in secret_names:
            value = assignment.group("value").strip()
            if value[:1] in {"'", '"'} and value[-1:] == value[:1]:
                literal = value[1:-1].strip()
                hardcoded = bool(literal) and not literal.startswith(("$", "`"))
            else:
                hardcoded = bool(value) and not value.startswith(("$", "`", "$("))
            if hardcoded:
                flags.append({"line": line_no, "category": "hardcoded-credential-shaped-assignment"})
        for name in secret_names:
            if any(literal_default(default) for default in shell_parameter_default(line, name)):
                flags.append({"line": line_no, "category": "secret-read-has-fallback-default"})

        if WARNING_RE.search(code) and not re.match(r"^\s*(?:warn|warning)\s*\(\)\s*\{", code, re.IGNORECASE):
            declared = False
            for pattern in cfg["non_fatal_patterns"]:
                try:
                    if re.search(pattern, line, re.IGNORECASE):
                        declared = True
                        suppressions += 1
                        break
                except re.error as exc:
                    return fail(f"invalid non_fatal_patterns regex {pattern!r}: {exc}")
            if not declared:
                flags.append({"line": line_no, "category": "warning-and-continue"})

        if "|" in code and "||" not in code and EXTERNAL_RE.search(code) and "pipefail" not in text:
            flags.append({"line": line_no, "category": "external-step-in-unprotected-pipeline"})

        if "|| true" in code and EXTERNAL_RE.search(code) and not re.search(r"^\s*_AIDE_ROOT=", code):
            declared = any(re.search(pattern, code, re.IGNORECASE) for pattern in cfg["non_fatal_patterns"])
            if not declared:
                flags.append({"line": line_no, "category": "external-step-explicitly-continues"})

    code_text = "\n".join(shell_code(line) for line in lines)
    if code_text and EXTERNAL_RE.search(code_text) and not re.search(r"(?:set\s+-[^\n]*e|set\s+-o\s+errexit)", text):
        flags.append({"line": 1, "category": "external-steps-without-fail-fast"})

    if statuses:
        flags.append({
            "line": 0,
            "category": "dirty-tree-including-untracked",
            "detail": f"{len(statuses)} status entr{'y' if len(statuses) == 1 else 'ies'} (tracked and untracked included)",
        })

    try:
        write_findings(repo, cfg, flags, 1, suppressions)
    except OSError as exc:
        return fail(f"could not write checks/DEPLOY-FINDINGS.md: {exc}")

    print(f"aide-checks: check-result name={CHECK} units=1 findings={len(flags)} suppressions={suppressions}")
    if flags:
        print(f"{CHECK}: REPORT {len(flags)} flag(s) in the configured deploy boundary")
        for flag in flags:
            location = f":{flag['line']}" if flag["line"] else ""
            print(f"  {cfg['script']}{location} [{flag['category']}]")
        return 1
    print(f"{CHECK}: REPORT 0 flags — suspect; investigate before treating this as clean")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
