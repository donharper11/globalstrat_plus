#!/usr/bin/env bash
# ─── check: no-committed-secrets ────────────────────────────────────────────
# Secret scanner over the git working tree at HEAD. Working tree only; history
# scanning is separate and noisier (spec §4.1).
#
# Contract:
#   exit 0  no findings
#   exit 1  findings (count on stdout, paths only — NEVER values)
#   exit 2  the check could not run (missing scanner, bad config)
#
# exit 2 is not a pass. A check that cannot run has not passed.
#
# Evidence for this check: NEXUS-C116, NEXUS-C118, BECSR-C139, AP-C028, AC-C051,
# AP-C043, and six globalstrat+ harness files. Four repos, independently.
set -uo pipefail

REPO_ROOT="${1:?repo root required}"
CONFIG="${2:?config path required}"
CHECK_NAME="no-committed-secrets"
WORK_PINS="$(mktemp)"
trap 'rm -rf "${WORK:-}" "$WORK_PINS"' EXIT

find_gitleaks() {
  # An explicit path wins, and it is consulted FIRST.
  #
  # Discovery below is a convenience for the two VMs, not a contract, and it
  # cannot be turned off by the environment: /usr/local/bin/gitleaks is probed by
  # absolute path whatever PATH and HOME say. That made the selftest's
  # missing-scanner assertion environment-dependent — on the VMs gitleaks lives
  # in ~/bin, so faking HOME concealed it and the assertion passed, while a CI
  # runner installs it to /usr/local/bin, where the check found it anyway and
  # exited 0. This variable makes that path deterministic on every host.
  #
  # It can only ever make the check STRICTER. A path that is not executable is
  # exit 2; a binary that is not gitleaks writes no report, which is also exit 2.
  # No value of it produces a pass.
  if [ -n "${AIDE_CHECKS_GITLEAKS:-}" ]; then
    [ -x "$AIDE_CHECKS_GITLEAKS" ] || return 1
    echo "$AIDE_CHECKS_GITLEAKS"; return 0
  fi
  if command -v gitleaks >/dev/null 2>&1; then command -v gitleaks; return 0; fi
  for c in "$HOME/bin/gitleaks" /usr/local/bin/gitleaks /usr/bin/gitleaks /opt/gitleaks/gitleaks; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  return 1
}

GL="$(find_gitleaks)" || {
  if [ -n "${AIDE_CHECKS_GITLEAKS:-}" ]; then
    echo "${CHECK_NAME}: ERROR AIDE_CHECKS_GITLEAKS is set to '${AIDE_CHECKS_GITLEAKS}', which is not executable." >&2
  else
    echo "${CHECK_NAME}: ERROR gitleaks not found on PATH, \$HOME/bin, /usr/local/bin or /usr/bin." >&2
  fi
  echo "${CHECK_NAME}: a scanner that is absent is not a scanner that passed." >&2
  exit 2
}

# ── config ─────────────────────────────────────────────────────────────────
readarray -t EXCLUDES < <(jq -r --arg c "$CHECK_NAME" '.checks[$c].exclude // [] | .[]' "$CONFIG")
readarray -t INCLUDES < <(jq -r --arg c "$CHECK_NAME" '.checks[$c].include // [] | .[]' "$CONFIG")

# allow_fields: suppress a finding whose value was assigned to a field with this
# name. This is NOT a path exclusion — spec §3 forbids excluding a path for noise,
# because a committed evidence dump is exactly where a real leak also lands. The
# file stays fully scanned; only the identifier-shaped field is discounted, so a
# real secret elsewhere in the same file, or on the same line, still fails.
#
# The anchor is gitleaks' own Match, which for generic-api-key carries the field
# name it matched (`feature_key":"<value>"`). Matching there rather than on the
# whole line matters: an evidence dump can be one very long line, and a
# line-level allowlist would then suppress a real secret sitting beside an
# identifier.
#
# Every entry needs a recorded reason. An allowlist nobody has to justify grows
# until the check means nothing.
readarray -t ALLOWFIELDS < <(jq -r --arg c "$CHECK_NAME" '.checks[$c].allow_fields // [] | .[]' "$CONFIG")

# allow_findings: pin an exception to ONE occurrence by gitleaks fingerprint
# (file:rule:line). Narrower than allow_fields, which covers a field name
# wherever it appears — this covers exactly one match and nothing else. Use it
# for a false positive in prose, where there is no field name to anchor on.
#
# It is deliberately brittle: if the file changes so the line moves, the
# fingerprint stops matching and the finding comes back to be re-judged. That
# is the safe direction to fail. Every entry needs a reason.
readarray -t ALLOWFINDINGS < <(jq -r --arg c "$CHECK_NAME" '.checks[$c].allow_findings // {} | keys[]' "$CONFIG")
PINS="$WORK_PINS"
: > "$PINS"
if [ "${#ALLOWFINDINGS[@]}" -gt 0 ] && [ -n "${ALLOWFINDINGS[0]}" ]; then
  for fp in "${ALLOWFINDINGS[@]}"; do
    reason="$(jq -r --arg c "$CHECK_NAME" --arg f "$fp" '.checks[$c].allow_findings[$f] // ""' "$CONFIG")"
    [ -z "$reason" ] && {
      echo "${CHECK_NAME}: ERROR allow_findings entry '$fp' has no reason." >&2; exit 2; }
    printf '%s\n' "$fp" >> "$PINS"
  done
fi

FIELD_RX=""
if [ "${#ALLOWFIELDS[@]}" -gt 0 ] && [ -n "${ALLOWFIELDS[0]}" ]; then
  for f in "${ALLOWFIELDS[@]}"; do
    case "$f" in
      *[!A-Za-z0-9_]*|"") echo "${CHECK_NAME}: ERROR allow_fields entry '$f' is not a bare field name." >&2; exit 2 ;;
    esac
    reason="$(jq -r --arg c "$CHECK_NAME" --arg f "$f" '.checks[$c].allow_fields_reasons[$f] // ""' "$CONFIG")"
    [ -z "$reason" ] && {
      echo "${CHECK_NAME}: ERROR allow_fields entry '$f' has no reason in allow_fields_reasons." >&2
      echo "${CHECK_NAME}: an unjustified allowlist is how a scanner stops meaning anything." >&2
      exit 2; }
  done
  alt="$(printf '%s|' "${ALLOWFIELDS[@]}")"; alt="${alt%|}"
  # An optional `obj.` / `alias.` qualifier counts as the same field: gitleaks
  # reports `f.feature_key='<v>'` for a SQL alias and `d.key === '<v>'` for a
  # property access. The field name still has to match in full — a truncated or
  # differently-named field is left as a finding rather than guessed at.
  FIELD_RX="^([A-Za-z_][A-Za-z0-9_]*\\.)?[\"']?(${alt})[\"']?[[:space:]]*[:=]"
fi

WORK="$(mktemp -d)"   # cleaned by the EXIT trap set above, together with WORK_PINS
TOML="$WORK/gitleaks.toml"

# Base ruleset plus this project's own paths. gitleaks' default allowlist skips
# nothing here by default; the include list in the config exists to make §4.1's
# requirement explicit and auditable, not to widen the scan.
{
  printf '[extend]\nuseDefault = true\n\n'
  if [ "${#EXCLUDES[@]}" -gt 0 ]; then
    printf '[allowlist]\ndescription = "per-repo exclusions, each with a recorded reason in checks.config.json"\npaths = [\n'
    for p in "${EXCLUDES[@]}"; do
      # translate a glob into a loose regex; anchored on the path segment
      rx="$(printf '%s' "$p" | sed -e 's/[.[\*^$()+?{}|]/\\&/g' -e 's/\\\*\\\*/§§/g' -e 's/\\\*/[^\/]*/g' -e 's/§§/.*/g')"
      printf '  """%s""",\n' "$rx"
    done
    printf ']\n'
  fi
} > "$TOML"

# ── scan ───────────────────────────────────────────────────────────────────
REPORT="$WORK/report.json"
"$GL" dir "$REPO_ROOT" \
  --config "$TOML" \
  --report-format json \
  --report-path "$REPORT" \
  --no-banner --exit-code 0 >"$WORK/gl.log" 2>&1
GLRC=$?
if [ "$GLRC" -ne 0 ] || [ ! -f "$REPORT" ]; then
  echo "${CHECK_NAME}: ERROR gitleaks failed to complete (rc=$GLRC)." >&2
  sed -e 's/[A-Za-z0-9_\-]\{16,\}/<REDACTED>/g' "$WORK/gl.log" >&2
  exit 2
fi

# Only findings on git-TRACKED files count. gitleaks `dir` walks the filesystem,
# which would otherwise flag untracked local .env files that are correctly
# gitignored — a false positive that gets the layer disabled.
TRACKED="$WORK/tracked.txt"
git --no-optional-locks -C "$REPO_ROOT" ls-files -z 2>/dev/null | tr '\0' '\n' | sort -u > "$TRACKED"
UNITS=$(sed '/^$/d' "$TRACKED" | wc -l | tr -d ' ')

# Classify each finding as a hit or as suppressed by allow_fields. The Secret
# itself is never carried out of this pipeline — only path, line, rule, and the
# allow/hit verdict.
jq -r --arg rx "$FIELD_RX" '
  .[] | [ .File, (.StartLine|tostring), .RuleID, (.Fingerprint // ""),
          (if ($rx|length) > 0 and ((.Match // "") | test($rx)) then "allow" else "hit" end)
        ] | @tsv' "$REPORT" 2>/dev/null \
  | while IFS=$'\t' read -r file line rule _fp verdict; do
      rel="${file#"$REPO_ROOT"/}"
      grep -Fxq "$rel" "$TRACKED" || continue
      # A fingerprint pin overrides the field verdict. Build it from the
      # repo-RELATIVE path: gitleaks reports an absolute one, which would bake
      # this machine's checkout directory into every config.
      relfp="${rel}:${rule}:${line}"
      if grep -Fxq "$relfp" "$PINS" 2>/dev/null; then verdict="pin"; fi
      printf '%s\t%s\t%s\n' "$rel" "$line" "$rule" >> "$WORK/${verdict}.tsv"
    done
for f in hit allow pin; do [ -f "$WORK/$f.tsv" ] || : > "$WORK/$f.tsv"; done
cp "$WORK/hit.tsv" "$WORK/hits.tsv"

# The include list is a hard requirement, not a filter: §4.1 says docs/** and
# README.md MUST be scanned. Fail the check if the config excludes them.
for inc in "${INCLUDES[@]}"; do
  for exc in "${EXCLUDES[@]:-}"; do
    [ "$inc" = "$exc" ] && {
      echo "${CHECK_NAME}: ERROR config both includes and excludes '$inc'." >&2; exit 2; }
  done
done

N=$(wc -l < "$WORK/hits.tsv" | tr -d ' ')
A=$(wc -l < "$WORK/allow.tsv" | tr -d ' ')
P=$(wc -l < "$WORK/pin.tsv" | tr -d ' ')
SUPPRESSIONS=$((A + P))

echo "aide-checks: check-result name=${CHECK_NAME} units=${UNITS} findings=${N} suppressions=${SUPPRESSIONS}"

if [ "$UNITS" -eq 0 ] && [ "$N" -eq 0 ]; then
  echo "${CHECK_NAME}: ERROR zero findings over zero examined units — could not run." >&2
  exit 2
fi

# A suppression is never silent. If the allowlist is doing the work, the count
# says so on both PASS and FAIL, so nobody reads a green line as "nothing found".
suppressed_note() {
  [ "$A" -gt 0 ] && echo "  ${A} finding(s) suppressed by allow_fields (${ALLOWFIELDS[*]}) — see allow_fields_reasons"
  [ "$P" -gt 0 ] && echo "  ${P} finding(s) suppressed by allow_findings, pinned to an exact file:rule:line — see the config for each reason"
  return 0
}

if [ "$N" -gt 0 ]; then
  echo "${CHECK_NAME}: FAIL ${N} finding(s) in tracked files"
  # paths, line numbers and rule ids only. Never the matched value.
  awk -F'\t' '{printf "  %s:%s  [%s]\n", $1, $2, $3}' "$WORK/hits.tsv"
  echo "  (values are never printed by this check; see SECURITY-NOTICE.md)"
  suppressed_note
  exit 1
fi
echo "${CHECK_NAME}: PASS 0 findings"
suppressed_note
exit 0
