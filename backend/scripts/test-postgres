#!/usr/bin/env bash
# Run Django tests against a fresh, disposable PostgreSQL container.
#
# This deliberately never reads the production systemd environment file and
# never writes a database credential to disk.  It is suitable for local and CI
# verification of the PostgreSQL-dependent test suite.
set -euo pipefail

if ! command -v docker >/dev/null 2>&1; then
  echo 'Docker is required for the disposable PostgreSQL test database.' >&2
  exit 2
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
backend_dir="$(cd "$script_dir/.." && pwd)"
container_name="globalstrat-plus-test-postgres-$$"
test_password="$(openssl rand -hex 32)"

cleanup() {
  docker rm -f "$container_name" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

docker run -d --rm --name "$container_name" \
  -e POSTGRES_DB=globalstrat_plus \
  -e POSTGRES_USER=globalstrat_test \
  -e POSTGRES_PASSWORD="$test_password" \
  -p 127.0.0.1::5432 \
  postgres:16-alpine >/dev/null

# How long to wait for the container to answer pg_isready. 30 s is plenty on
# an idle host; on 2026-09-22 the host's disk stalled (ext4 journal thread in
# D state, I/O pressure ~80 %) and initdb's fsyncs took minutes, so every
# runner on the host failed here without running a test. The default is
# unchanged; a longer window is opt-in per run.
ready_seconds="${TEST_POSTGRES_READY_SECONDS:-30}"
host_port=''
for _attempt in $(seq 1 "$ready_seconds"); do
  host_port="$(docker port "$container_name" 5432/tcp | sed -n 's/.*:\([0-9][0-9]*\)$/\1/p' | head -n 1)"
  if [ -n "$host_port" ] && pg_isready -h 127.0.0.1 -p "$host_port" -U globalstrat_test >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

if [ -z "$host_port" ] || ! pg_isready -h 127.0.0.1 -p "$host_port" -U globalstrat_test >/dev/null 2>&1; then
  echo 'Disposable PostgreSQL did not become ready.' >&2
  exit 1
fi

cd "$backend_dir"
DB_NAME=globalstrat_plus \
DB_USER=globalstrat_test \
DB_PASSWORD="$test_password" \
DB_HOST=127.0.0.1 \
DB_PORT="$host_port" \
python3 manage.py test --noinput "$@"
